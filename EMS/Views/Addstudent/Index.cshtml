@model List<EMS.Models.ClassStudent>
@{
    var cls = ViewBag.Class as EMS.Models.Class;
    bool showForm = ViewBag.ShowForm != null && (bool)ViewBag.ShowForm;
}

<link rel="stylesheet" href="~/css/class-details.css" asp-append-version="true" />

<div class="container mt-4">

    <a asp-controller="Teacher" asp-action="Dashboard">← Back to Classes</a>

    <div class="card mt-3 mb-3">
        <div class="card-body">
            <h4>Grade @cls.Grade - @cls.Place</h4>
            <p>Students (@Model.Count)</p>
        </div>
    </div>

    @await Html.PartialAsync("_ClassTabs", cls)

    <!-- ✅ Add button -->
    <button type="button" class="btn btn-primary mb-3" onclick="toggleStudentForm()">
        + Add Student
    </button>

    <!-- ✅ Error message -->
    @if (TempData["StudentError"] != null)
    {
        <div class="alert alert-danger">@TempData["StudentError"]</div>
    }

    <!-- ✅ Inline form card -->
    <div id="addStudentForm" class="card mb-4 @(showForm ? "" : "d-none")">
        <div class="card-body">
            <h5 class="mb-3">Add New Student</h5>

            <form asp-action="Add" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="classId" value="@cls.Id" />

                <div class="mb-3">
                    <label class="form-label">Student Code</label>
                    <input name="studentCode" class="form-control" placeholder="e.g. STU001" required />
                    <small class="text-muted">Type the student code from student dashboard.</small>
                </div>

                <button class="btn btn-primary">Add Student</button>
                <button type="button" class="btn btn-secondary ms-2" onclick="toggleStudentForm()">Cancel</button>
            </form>
        </div>
    </div>

    <!-- ✅ Student list -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="m-0">Students (@Model.Count)</h5>
    </div>

    @foreach (var cs in Model)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <strong>@cs.Student.Name</strong><br />
                    <small class="text-muted">@cs.Student.StudentCode</small>
                </div>

                <a asp-action="Remove" asp-route-id="@cs.Id"
                   class="btn btn-sm btn-outline-danger" title="Remove">
                    🗑
                </a>
            </div>
        </div>
    }
</div>

<script>
    function toggleStudentForm() {
        const form = document.getElementById("addStudentForm");
        form.classList.toggle("d-none");

        if (!form.classList.contains("d-none")) {
            form.scrollIntoView({ behavior: "smooth", block: "start" });
        }
    }

    // If server says showForm=1, scroll automatically
    window.addEventListener("load", function () {
        const form = document.getElementById("addStudentForm");
        if (form && !form.classList.contains("d-none")) {
            form.scrollIntoView({ behavior: "smooth", block: "start" });
        }
    });
</script>
