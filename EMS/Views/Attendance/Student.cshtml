@model List<EMS.Models.Attendence>

@{
    ViewData["Title"] = "My Attendance";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var cls = ViewBag.Class as EMS.Models.Class;
}

<div class="container" style="max-width: 1100px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-1">My Attendance</h3>
            <div class="text-muted">
                Class: <b>@cls?.Subject</b> | Grade: <b>@cls?.Grade</b> | Teacher: <b>@cls?.Teacher?.Name</b>
            </div>
        </div>
        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-outline-secondary">Back</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">No attendance records found for this class yet.</div>
    }
    else
    {
        var presentCount = Model.Count(a => a.IsPresent);
        var total = Model.Count;
        var percent = total == 0 ? 0 : (int)Math.Round(presentCount * 100.0 / total);

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-muted">Total Days</div>
                        <div style="font-size: 28px; font-weight: 800;">@total</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-muted">Present</div>
                        <div style="font-size: 28px; font-weight: 800;">@presentCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-muted">Rate</div>
                        <div style="font-size: 28px; font-weight: 800;"><text>@percent%</text></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 180px;">Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>@a.Date.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (a.IsPresent)
                                    {
                                        <span class="badge bg-success">Present</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Absent</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
