@model List<EMS.Models.Attendence>

@{
    ViewData["Title"] = "My Attendance";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var cls = ViewBag.Class as EMS.Models.Class;
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-class.css" asp-append-version="true" />
}

<div class="student-class">
    <a class="backlink" asp-controller="Student" asp-action="Dashboard">? Back to Classes</a>

    <div class="class-hero">
        <div class="class-hero-top">
            <div>
                <h1 class="class-title">My Attendance</h1>
                <div class="class-subtitle">@cls?.Subject • Grade <b>@cls?.Grade</b> • <b>@cls?.Place</b> • Teacher: <b>@cls?.Teacher?.Name</b></div>
            </div>
            <div class="tag">Attendance</div>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty">No attendance records found for this class yet.</div>
    }
    else
    {
        var presentCount = Model.Count(a => a.IsPresent);
        var total = Model.Count;
        var percent = total == 0 ? 0 : (int)Math.Round(presentCount * 100.0 / total);

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="item" style="justify-content: flex-start;">
                    <div>
                        <p class="item-title">Total Days</p>
                        <div style="font-size: 30px; font-weight: 900;">@total</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="item" style="justify-content: flex-start;">
                    <div>
                        <p class="item-title">Present</p>
                        <div style="font-size: 30px; font-weight: 900; color: #16a34a;">@presentCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="item" style="justify-content: flex-start;">
                    <div>
                        <p class="item-title">Rate</p>
                        <div style="font-size: 30px; font-weight: 900;">@percent%</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="item" style="display:block; padding:0; overflow:hidden;">
            <div class="p-3" style="border-bottom:1px solid #e5e7eb; font-weight:900;">Attendance List</div>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 180px;">Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>@a.Date.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (a.IsPresent)
                                    {
                                        <span class="badge bg-success">Present</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Absent</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
