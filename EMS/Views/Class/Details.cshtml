@model EMS.Models.Class

@{
    ViewData["Title"] = "Class-Details";
    var studentCount = Model.ClassStudents?.Count ?? 0;

    // Default stats (your original placeholders)
    var presentCount = 0;
    var absentCount = studentCount;
    var percent = studentCount == 0 ? 0 : (presentCount * 100 / studentCount);

    // For Report button (AttendanceController.Report requires date)
    var reportDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<link rel="stylesheet" href="~/css/class-details.css" />

<div class="class-details-container">

    <!-- Back -->
    <a asp-controller="Class"
       asp-action="Index"
       class="back-link">
        ← Back to Classes
    </a>

    <!-- Header Card -->
    <div class="class-header-card">
        <h4>Grade @Model.Grade - @Model.Place</h4>
        <p>@studentCount student(s)</p>
    </div>

    <!-- Tabs -->
    <div class="custom-tabs">

        <!-- ✅ FIX: Attendance tab should go to AttendanceController -->
        <a class="tab-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")"
           asp-controller="Attendance" asp-action="Index" asp-route-classId="@Model.Id">
            Attendance
        </a>

        <a class="tab-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Homework" ? "active" : "")"
           asp-controller="Homework" asp-action="Index" asp-route-classId="@Model.Id">
            Homework
        </a>

        <a class="tab-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notes" ? "active" : "")"
           asp-controller="Notes" asp-action="Index" asp-route-classId="@Model.Id">
            Notes
        </a>

        <a class="tab-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Results" ? "active" : "")"
           asp-controller="Results" asp-action="Index" asp-route-classId="@Model.Id">
            Results
        </a>

        <a class="tab-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Addstudent" ? "active" : "")"
           asp-controller="Addstudent" asp-action="Index" asp-route-classId="@Model.Id">
            Student
        </a>
    </div>

    <!-- Stats cards -->
    <div class="att-stats">
        <div class="stat-card">
            <div class="stat-title">Present</div>
            <div class="stat-value stat-green">@presentCount</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Absent</div>
            <div class="stat-value stat-red">@absentCount</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Attendance %</div>
            <div class="stat-value stat-blue">@percent%</div>
        </div>
    </div>

    <!-- ✅ Enroll by Student Code -->
    <form asp-controller="Class"
          asp-action="EnrollByCode"
          method="post"
          class="mt-3">

        @Html.AntiForgeryToken()
        <input type="hidden" name="classId" value="@Model.Id" />

        <div class="d-flex gap-2">
            <input name="studentCode"
                   class="form-control"
                   placeholder="Enter Student Code (STD-2026-AB12)"
                   required />
            <button type="submit" class="btn btn-dark">Enroll</button>
        </div>
    </form>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2">@TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info mt-2">@TempData["Info"]</div>
    }

    <!-- Attendance form (your existing design) -->
    <form asp-controller="Attendance"
          asp-action="Save"
          method="post"
          class="attendance-card">

        <input type="hidden" name="classId" value="@Model.Id" />

        <!-- Toolbar -->
        <div class="att-toolbar">
            <div class="att-date">
                <label class="fw-semibold">Date</label>
                <input type="date"
                       name="date"
                       class="form-control att-date-input"
                       required />
            </div>

            <div class="att-actions">
                <button type="submit" class="btn btn-primary att-save-btn">
                    💾 Save
                </button>

                <!-- ✅ FIX: Report needs date -->
                <a class="btn btn-outline-secondary att-report-btn"
                   asp-controller="Attendance"
                   asp-action="Report"
                   asp-route-classId="@Model.Id"
                   asp-route-date="@reportDate">
                    ⬇ Report
                </a>
            </div>
        </div>

        <hr class="att-divider" />

        <!-- Student List -->
        @if (Model.ClassStudents == null || Model.ClassStudents.Count == 0)
        {
            <div class="alert alert-info">
                No students enrolled yet.
            </div>
        }
        else
        {
            @foreach (var cs in Model.ClassStudents)
            {
                <div class="student-row">
                    <div>
                        <div class="student-name">@(cs.Student?.Name ?? "Unknown")</div>
                        <div class="student-code">@(cs.Student?.StudentCode ?? "N/A")</div>
                    </div>

                    <input type="checkbox"
                           name="presentStudentIds"
                           value="@cs.StudentId"
                           checked />
                </div>
            }
        }
    </form>

</div>
