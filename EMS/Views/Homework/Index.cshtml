@model List<EMS.Models.Homework>
@{
    var cls = ViewBag.Class as EMS.Models.Class;
}

<link rel="stylesheet" href="~/css/class-details.css" asp-append-version="true" />

<div class="container mt-4">

    <a asp-controller="Teacher" asp-action="Dashboard" class="back-link">
        ← Back to Classes
    </a>

    <div class="card mt-3 mb-3">
        <div class="card-body">
            <h4>Grade @cls?.Grade - @cls?.Place</h4>
            <p>@Model.Count homework(s)</p>
        </div>
    </div>

    @await Html.PartialAsync("_ClassTabs", cls)

    <!-- ✅ Button (NO navigation) -->
    <button type="button" class="btn btn-primary mb-3" onclick="openHomeworkForm()">
        + Add Homework
    </button>

    <!-- ✅ Inline Add Homework form (hidden until button click) -->
    <div id="addHomeworkSection" class="card mb-4 d-none">
        <div class="card-body">
            <h5 class="mb-3">Add Homework</h5>

            <!-- IMPORTANT: names match your HomeworkController POST -->
            <form asp-controller="Homework"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden" name="ClassId" value="@cls?.Id" />

                <div class="mb-3">
                    <label class="form-label">Homework Title</label>
                    <input name="Title" class="form-control" placeholder="Homework title" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Description (optional)"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Assignment PDF</label>
                    <input type="file"
                           name="pdfFile"
                           accept=".pdf"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Due Date</label>
                    <input type="date" name="DueDate" class="form-control" required />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Save Homework</button>

                    <button type="button" class="btn btn-secondary" onclick="closeHomeworkForm()">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ✅ Homework list -->
    @foreach (var hw in Model)
    {
        <div class="border-bottom py-3 d-flex justify-content-between align-items-center">
            <div>
                <strong>@hw.Title</strong><br />
                <small>Due: @hw.DueDate.ToShortDateString()</small>
            </div>

            <div class="d-flex align-items-center">
                <a href="@hw.AssssignmentFile" class="btn btn-sm btn-outline-secondary" download>
                    Download
                </a>

                <a asp-action="Delete"
                   asp-route-id="@hw.id"
                   class="btn btn-sm btn-outline-danger ms-2">
                    🗑
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function openHomeworkForm() {
            const section = document.getElementById("addHomeworkSection");
            section.classList.remove("d-none");
            section.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        function closeHomeworkForm() {
            document.getElementById("addHomeworkSection").classList.add("d-none");
        }
    </script>

    <style>
        .d-none {
            display: none;
        }
    </style>
}
