@model List<EMS.Models.Note>
@{
    var cls = ViewBag.Class as EMS.Models.Class;
    bool showForm = ViewBag.ShowForm != null && (bool)ViewBag.ShowForm;
}

<link rel="stylesheet" href="~/css/class-details.css" asp-append-version="true" />

<div class="class-details-container">

    <!-- Back -->
    <a asp-controller="Teacher" asp-action="Dashboard" class="back-link">
        ← Back to Classes
    </a>

    <!-- Header -->
    <div class="class-header-card">
        <h4>Grade @cls.Grade - @cls.Place</h4>
        <p>@Model.Count note(s)</p>
    </div>

    @await Html.PartialAsync("_ClassTabs", cls)

    <!-- Add Notes Button -->
    <button type="button" class="btn btn-primary mb-3" onclick="toggleNotesForm()">
        + Add Notes
    </button>

    <!-- Error -->
    @if (TempData["NotesError"] != null)
    {
        <div class="alert alert-danger">@TempData["NotesError"]</div>
    }

    <!-- Add Notes Form (INLINE) -->
    <div id="addNotesForm" class="card mb-4 @(showForm ? "" : "d-none")">
        <div class="card-body">
            <h5 class="mb-3">Add Notes</h5>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" name="ClassId" value="@cls.Id" />

                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input name="Title" class="form-control" placeholder="Notes title" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Upload File (PDF)</label>
                    <input type="file" name="pdfFile" accept=".pdf" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary">Add Notes</button>
                <button type="button" class="btn btn-secondary ms-2" onclick="toggleNotesForm()">Cancel</button>
            </form>
        </div>
    </div>

    <!-- Notes List -->
    @foreach (var note in Model)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">

                <strong>@note.Title</strong>

                <div class="d-flex gap-2">
                    <a href="@note.NotesFile"
                       class="btn btn-sm btn-outline-secondary"
                       download>
                        Download
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@note.Id"
                       class="btn btn-sm btn-outline-danger">
                        🗑
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function toggleNotesForm() {
        const form = document.getElementById("addNotesForm");
        form.classList.toggle("d-none");

        if (!form.classList.contains("d-none")) {
            form.scrollIntoView({ behavior: "smooth", block: "start" });
        }
    }
</script>
