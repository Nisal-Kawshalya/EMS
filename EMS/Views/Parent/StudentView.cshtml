@model EMS.Models.Student

@{
    Layout = null;
    ViewData["Title"] = "Student";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/parent-student.css" asp-append-version="true" />
</head>
<body>

<div class="parent-student-page">
    <div class="parent-wrap">

        <div class="parent-header">
            <div class="parent-header-top">
                <div>
                    <h1>@Model.Name</h1>
                    <div class="meta">
                        Student Code: <b>@Model.StudentCode</b> • Phone: <b>@Model.PhoneNumber</b>
                    </div>
                </div>

                <div class="parent-actions">
                    <a asp-controller="Parent" asp-action="Index" class="parent-btn-primary">← Change Code</a>
                    <a asp-controller="Home" asp-action="Index" class="parent-btn-primary">Home</a>
                </div>
            </div>
        </div>

        <div class="parent-section-title">Enrolled Classes</div>

        @if (Model.ClassStudents == null || Model.ClassStudents.Count == 0)
        {
            <div class="parent-empty">No enrolled classes.</div>
        }
        else
        {
            <div class="parent-grid">
                @foreach (var cs in Model.ClassStudents)
                {
                    var c = cs.Class;
                    if (c == null) { continue; }

                    <div class="parent-class-card">
                        <div class="head">
                            <h3>@c.Subject</h3>
                            <span class="badge">Grade @c.Grade</span>
                        </div>
                        <div class="body">
                            <div><b>Location:</b> @c.Place</div>
                            <div><b>Teacher:</b> @c.Teacher?.Name</div>
                        </div>
                        <div class="actions">
                            <a class="view"
                               asp-controller="Parent"
                               asp-action="Class"
                               asp-route-studentCode="@Model.StudentCode"
                               asp-route-classId="@c.Id">
                                View Class
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
