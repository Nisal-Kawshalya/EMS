@model EMS.Models.Student

@{
    ViewData["Title"] = "Student Info";
}

<div class="container mt-4">
    <h3>@Model.Name</h3>
    <p><b>Student Code:</b> @Model.StudentCode</p>
    <p><b>Phone:</b> @Model.PhoneNumber</p>

    <hr />

    <h5>Enrolled Classes</h5>

    @if (Model.ClassStudents == null || Model.ClassStudents.Count == 0)
    {
        <div class="alert alert-info">No enrolled classes.</div>
    }
    else
    {
        <div class="row">
            @foreach (var cs in Model.ClassStudents)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6>Grade @cs.Class?.Grade - @cs.Class?.Place</h6>
                            <p class="text-muted mb-0">Teacher: @cs.Class?.Teacher?.Name</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
