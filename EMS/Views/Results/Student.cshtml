@model List<EMS.Models.Result>

@{
    ViewData["Title"] = "My Results";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var cls = ViewBag.Class as EMS.Models.Class;
}

<div class="container" style="max-width: 1100px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-1">My Results</h3>
            <div class="text-muted">
                Class: <b>@cls?.Subject</b> | Grade: <b>@cls?.Grade</b> | Teacher: <b>@cls?.Teacher?.Name</b>
            </div>
        </div>
        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-outline-secondary">Back</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">No results published for this class yet.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 220px;">Exam</th>
                            <th style="width: 170px;">Date</th>
                            <th style="width: 120px;">Marks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.ExamTitle</td>
                                <td>@r.ExamDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge bg-primary" style="font-size: 14px;">@r.Marks</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
