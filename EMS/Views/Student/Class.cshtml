@model EMS.Models.Class
@{
    ViewData["Title"] = "Class Details";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    string tab = ViewBag.ActiveTab ?? "Homework";

    var http = ViewContext.HttpContext;
    var studentUserId = http.Session.GetInt32("UserId");
    // we don't have StudentId here; we will match through navigation if loaded (Student may be null).
    // For safety, results display will be limited in controller later if needed.
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-class.css" asp-append-version="true" />
}

<div class="student-class">
    <a class="backlink" asp-controller="Student" asp-action="Dashboard">← Back to Classes</a>

    <div class="class-hero">
        <div class="class-hero-top">
            <div>
                <h1 class="class-title">@Model.Subject</h1>
                <div class="class-subtitle">Grade <b>@Model.Grade</b> • <b>@Model.Place</b> • Teacher: <b>@Model.Teacher?.Name</b></div>
            </div>
            <div class="tag">Class #@Model.Id</div>
        </div>
    </div>

    <div class="tabbar">
        <a class="@(tab == "Homework" ? "active" : "")"
           asp-controller="Student" asp-action="Class"
           asp-route-classId="@Model.Id"
           asp-route-tab="Homework">Homework</a>

        <a class="@(tab == "Notes" ? "active" : "")"
           asp-controller="Student" asp-action="Class"
           asp-route-classId="@Model.Id"
           asp-route-tab="Notes">Notes</a>

        <a class="@(tab == "Results" ? "active" : "")"
           asp-controller="Student" asp-action="Class"
           asp-route-classId="@Model.Id"
           asp-route-tab="Results">Results</a>
    </div>

    @if (tab == "Homework")
    {
        if (Model.Homeworks != null && Model.Homeworks.Any())
        {
            <div class="list">
                @foreach (var hw in Model.Homeworks.OrderByDescending(h => h.CreatedDate))
                {
                    <div class="item">
                        <div>
                            <p class="item-title">@hw.Title</p>
                            <div class="item-meta">Due: @hw.DueDate.ToString("yyyy-MM-dd")</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(hw.AssssignmentFile))
                        {
                            <a class="download" href="@hw.AssssignmentFile">Download</a>
                        }
                        else
                        {
                            <span class="pill">No file</span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty">No homework available.</div>
        }
    }

    @if (tab == "Notes")
    {
        if (Model.Notes != null && Model.Notes.Any())
        {
            <div class="list">
                @foreach (var note in Model.Notes.OrderByDescending(n => n.Createddate))
                {
                    <div class="item">
                        <div>
                            <p class="item-title">@note.Title</p>
                            <div class="item-meta">Posted: @note.Createddate.ToString("yyyy-MM-dd")</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(note.NotesFile))
                        {
                            <a class="download" href="@note.NotesFile">Download</a>
                        }
                        else
                        {
                            <span class="pill">No file</span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty">No notes available.</div>
        }
    }

    @if (tab == "Results")
    {
        // Prefer results filtered in controller; as a fallback, show all if Student navigation isn't available.
        var results = Model.Results?.OrderByDescending(r => r.ExamDate).ToList() ?? new List<EMS.Models.Result>();

        if (results.Any())
        {
            <div class="list">
                @foreach (var r in results)
                {
                    <div class="item">
                        <div>
                            <p class="item-title">@r.ExamTitle</p>
                            <div class="item-meta">Date: @r.ExamDate.ToString("yyyy-MM-dd")</div>
                        </div>
                        <span class="pill">Marks: <b>@r.Marks</b></span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty">No results published yet.</div>
        }
    }
</div>
