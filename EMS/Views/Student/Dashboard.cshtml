@model EMS.Models.Student

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="dashboard-container">
    <!-- WELCOME HEADER -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1>Welcome, <span class="highlight">@Model?.Name</span> 👋</h1>
            <p class="header-subtitle">Student Code: <strong>@Model?.StudentCode</strong></p>
        </div>
    </div>

    <!-- QUICK STATS -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📚</div>
            <div class="stat-content">
                <div class="stat-label">Enrolled Classes</div>
                <div class="stat-value">@(Model?.ClassStudents?.Count ?? 0)</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📋</div>
            <div class="stat-content">
                <div class="stat-label">Attendance Rate</div>
                <div class="stat-value">
                    @{
                        if (Model?.Attendences?.Count > 0)
                        {
                            var presentCount = Model.Attendences.Count(a => a.IsPresent);
                            var percentage = (presentCount * 100) / Model.Attendences.Count;
                            <text>@percentage%</text>
                        }
                        else
                        {
                            <text>N/A</text>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📊</div>
            <div class="stat-content">
                <div class="stat-label">Total Results</div>
                <div class="stat-value">@(Model?.Results?.Count ?? 0)</div>
            </div>
        </div>
    </div>

    <!-- ENROLLED CLASSES SECTION -->
    <div class="classes-section">
        <h2>Your Enrolled Classes</h2>
        <p class="section-subtitle">Only classes your teacher enrolled you into</p>

        @if (Model?.ClassStudents?.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <h3>No Classes Yet</h3>
                <p>You're not enrolled in any classes. Contact your teacher to enroll you using your Student Code.</p>
            </div>
        }
        else
        {
            <div class="classes-grid">
                @foreach (var classStudent in Model.ClassStudents ?? new List<EMS.Models.ClassStudent>())
                {
                    var classInfo = classStudent.Class;
                    <div class="class-card">
                        <div class="class-card-header">
                            <h3>@classInfo?.Subject</h3>
                            <span class="grade-badge">Grade @classInfo?.Grade</span>
                        </div>

                        <div class="class-card-body">
                            <div class="class-detail">
                                <span class="detail-label">📍 Location:</span>
                                <span class="detail-value">@classInfo?.Place</span>
                            </div>
                            <div class="class-detail">
                                <span class="detail-label">👨‍🏫 Teacher:</span>
                                <span class="detail-value">@classInfo?.Teacher?.Name</span>
                            </div>
                        </div>

                        <div class="class-card-actions">
                            <a asp-controller="Student" asp-action="Class" asp-route-classId="@classInfo?.Id" class="btn-action primary">
                                📚 View Details
                            </a>
                            <a asp-controller="Attendance" asp-action="Student" asp-route-classId="@classInfo?.Id" class="btn-action secondary">
                                📋 Attendance
                            </a>
                            <a asp-controller="Results" asp-action="Student" asp-route-classId="@classInfo?.Id" class="btn-action success">
                                📊 Results
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/student-dashboard.css" asp-append-version="true" />
}
