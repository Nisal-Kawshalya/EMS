@{
    ViewData["Title"] = "Teacher Dashboard";
   
}

<link rel="stylesheet" href="~/css/teacher-dashboard.css" />

<div class="td-page">
    

    <div class="td-header">
        <h1>Welcome Back, Teacher</h1>
        <p>Here's an overview of your classes and students</p>
    </div>

    <!-- STATS -->
    <div class="td-stats">
        <div class="td-stat-card">
            <div>
                <div class="td-stat-label">Total Students</div>
                <div class="td-stat-value">124</div>
            </div>
            <div class="td-stat-icon td-icon-blue">
                <span>👥</span>
            </div>
        </div>

        <div class="td-stat-card">
            <div>
                <div class="td-stat-label">Total Classes</div>
                <div class="td-stat-value">8</div>
            </div>
            <div class="td-stat-icon td-icon-green">
                <span>📘</span>
            </div>
        </div>

        <div class="td-stat-card">
            <div>
                <div class="td-stat-label">Avg. Attendance</div>
                <div class="td-stat-value">94%</div>
            </div>
            <div class="td-stat-icon td-icon-purple">
                <span>📈</span>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="td-card">
        <div class="td-card-title">Quick Actions</div>
        <div class="td-card-subtitle">Common tasks you perform frequently</div>

        <div class="td-actions">
            <a class="td-btn td-btn-primary" asp-controller="Class" asp-action="Create">
                + New Class
            </a>
            <a class="td-btn td-btn-outline" asp-controller="Attendance" asp-action="Index">
                Mark Attendance
            </a>
            <a class="td-btn td-btn-outline" asp-controller="Notes" asp-action="Create">
                Post Announcement
            </a>
            <a class="td-btn td-btn-outline" asp-controller="Results" asp-action="Create">
                Enter Results
            </a>
        </div>
    </div>

    <!-- CLASSES LIST -->
    <div class="td-card">
        <div class="td-card-title">Your Classes</div>
        <div class="td-card-subtitle">Classes you're currently teaching</div>

        <div class="td-class-list">
            <div class="td-class-row">
             

                <div class="td-class-right">
                    <div class="td-class-count">0 Students</div>
                    <a class="td-btn-small" asp-controller="Class" asp-action="Details" asp-route-id="1">
                        Manage
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
