@model List<EMS.Models.Class>

@{
    ViewData["Title"] = "Teacher Dashboard";

    int totalClasses = ViewBag.TotalClasses ?? 0;
    int totalStudents = ViewBag.TotalStudents ?? 0;
}


<link rel="stylesheet" href="~/css/teacher-dashboard.css" asp-append-version="true" />

<div class="td-page">

    <div class="td-header">
        <h1>Welcome Back, Teacher</h1>
        <p>Here's an overview of your classes and students</p>
    </div>

    <!-- STATS -->
    <div class="td-stats">
        <div class="td-stat-card">
            <div>
                <div class="td-stat-label">Total Students</div>
                <div class="td-stat-value">@totalStudents</div>
            </div>
            <div class="td-stat-icon td-icon-blue">
                <span>👥</span>
            </div>
        </div>

        <div class="td-stat-card">
            <div>
                <div class="td-stat-label">Total Classes</div>
                <div class="td-stat-value">@totalClasses</div>
            </div>
            <div class="td-stat-icon td-icon-green">
                <span>📘</span>
            </div>
        </div>

        <div class="td-stat-card">
            <div>
                <div class="td-stat-label">Avg. Attendance</div>
                <div class="td-stat-value">94%</div>
            </div>
            <div class="td-stat-icon td-icon-purple">
                <span>📈</span>
            </div>
        </div>
    </div>

    <!-- CLASSES LIST -->
    <div class="td-card">
        <div class="td-card-title">Your Classes</div>
        <div class="td-card-subtitle">Classes you're currently teaching</div>

        <div class="td-class-list">
            @if (Model == null || Model.Count == 0)
            {
                <div class="p-3 text-muted">
                    No classes found.
                </div>
            }
            else
            {
                @foreach (var cls in Model)
                {
                    <div class="td-class-row">
                        <!-- LEFT SIDE -->
                        <div class="td-class-left">
                            <div class="td-class-name">Grade @cls.Grade - @cls.Place</div>
                            <div class="td-class-room">@cls.Place</div>
                        </div>

                        <!-- RIGHT SIDE -->
                        <div class="td-class-right">
                            <div class="td-class-count">
                                @(cls.ClassStudents?.Count ?? 0) Students
                            </div>

                            <a class="td-btn-small"
                               asp-controller="Class"
                               asp-action="Details"
                               asp-route-id="@cls.Id">
                                Manage
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
